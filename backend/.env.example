# AIVCS backend environment configuration (copy to backend/.env and fill in).
# Never commit real values. backend/.env is git-ignored.

# Moonshot Kimi vision API key (Phase 2.1 Stage 2B).
# Get one at https://platform.kimi.com/console/api-keys
AIVCS_KIMI_API_KEY=

# Optional overrides (defaults shown):
# AIVCS_KIMI_BASE_URL=https://api.moonshot.cn/v1
# AIVCS_KIMI_MODEL=kimi-k2.6
# AIVCS_KIMI_TIMEOUT_SECONDS=240

# Reserved for a future real image-to-3d vendor (Phase 2.4+). Until a vendor is
# implemented, setting this does nothing and NO network requests are made.
# AIVCS_REAL3D_API_KEY=

# Reserved for the Tripo image-to-3d adapter (Phase 2.4-C). Offline scaffold
# only - never registered, never called, without a real key + explicit approval.
# AIVCS_TRIPO_API_KEY=

# LocalLowPower skinned output (Phase 2.6-C). Default OFF keeps the existing
# unskinned GLB byte-stable; enable to emit a SkinnedMesh GLB via RigBuilder.
# AIVCS_LOCAL3D_RIG_ENABLED=false
